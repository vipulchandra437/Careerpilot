# Voice interview (P8-14). Keys are read only by server-side Next.js routes.
# Local SQLite. Vercel uses a Neon Postgres URL with prisma/schema.prod.prisma.
INTERVIEW_DATABASE_URL="file:./interview.db"

# Provider chain: Groq first, then Gemini, then a free OpenRouter model.
# With no keys the interview falls back to the typed question bank.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Same secret as the FastAPI backend, used to verify the existing JWT in the
# interview route. Never expose this to the browser.
JWT_SECRET_KEY=
