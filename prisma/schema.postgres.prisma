generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum ExperienceLevel {
  ENTRY
  INTERMEDIATE
  EXPERIENCED
}

enum SkillCategory {
  PROGRAMMING_LANGUAGE
  FRAMEWORK
  DATABASE
  AI_ML
  CLOUD
  DEVOPS
  TOOL
  SOFT_SKILL
  OTHER
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewType {
  HR
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  AI_ML
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
}

enum GapStatus {
  STRONG
  GOOD
  NEEDS_IMPROVEMENT
  MISSING
}

enum ScoreType {
  OVERALL_READINESS
  RESUME
  CODING
  INTERVIEW
  COMMUNICATION
  GITHUB
  LINKEDIN
  PROJECTS
  SKILL_COVERAGE
  COMPANY_READINESS
  MOCK_INTERVIEW
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  COMPILE_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  SYSTEM_ERROR
}

enum Importance {
  ESSENTIAL
  IMPORTANT
  NICE_TO_HAVE
}

enum RoadmapStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum JobStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

enum NotificationType {
  JOB_ALERT
  LEARNING_REMINDER
  INTERVIEW_REMINDER
  WEEKLY_SUMMARY
  SYSTEM
}

enum PlanType {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

enum TaskType {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  emailVerified        DateTime?
  passwordHash         String?
  image                String?
  role                 UserRole  @default(STUDENT)
  passwordResetToken   String?
  passwordResetExpires DateTime?
  consentGivenAt       DateTime?
  consentVersion       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  profile               StudentProfile?
  codingSubmissions     CodingSubmission[]
  codingAssessments     CodingAssessment[]
  interviews            Interview[]
  communicationAnalyses CommunicationAnalysis[]
  githubAnalyses        GitHubAnalysis[]
  linkedinAnalyses      LinkedInAnalysis[]
  projects              Project[]
  scoreHistories        ScoreHistory[]
  careerReports         CareerReport[]
  accounts              Account[]
  sessions              Session[]
  authenticators        Authenticator[]
  mentorConversations   MentorConversation[]
  codingStreak          CodingStreak?
  codingBookmarks       CodingBookmark[]
  jdAnalyses            JDAnalysis[]
  savedJobs             Job[]
  notifications         Notification[]
  subscription          Subscription?
}

// NextAuth.js (v5) adapter models — required by PrismaAdapter for OAuth
// provider support and session token management.
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model StudentProfile {
  id                    String           @id @default(cuid())
  userId                String           @unique
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  location              String?
  bio                   String?
  experienceLevel       ExperienceLevel?
  preferredDomain       String?
  studyHoursPerWeek     Int?
  githubUrl             String?
  linkedinUrl           String?
  portfolioUrl          String?
  photoUrl              String?
  onboardingCompletedAt DateTime?
  targetCompanyId       String?
  targetJobRoleId       String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  education          Education?
  studentSkills      StudentSkill[]
  skillGaps          SkillGap[]
  learningRoadmaps   LearningRoadmap[]
  companyReadinesses CompanyReadiness[]
  resumes            Resume[]

  targetCompany Company? @relation("ProfileTargetCompany", fields: [targetCompanyId], references: [id])
  targetJobRole JobRole? @relation("ProfileTargetJobRole", fields: [targetJobRoleId], references: [id])
}

model Education {
  id             String         @id @default(cuid())
  profileId      String         @unique
  profile        StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  college        String
  degree         String
  branch         String?
  graduationYear Int?
  cgpa           Float?
}

model Skill {
  id          String        @id @default(cuid())
  name        String        @unique
  category    SkillCategory
  description String?
  createdAt   DateTime      @default(now())

  studentSkills     StudentSkill[]
  skillRequirements CompanySkillRequirement[]
  skillGaps         SkillGap[]
}

model StudentSkill {
  id          String           @id @default(cuid())
  profileId   String
  profile     StudentProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill            @relation(fields: [skillId], references: [id])
  rating      Int // 1-5 self-assessed proficiency
  proficiency ProficiencyLevel
  createdAt   DateTime         @default(now())

  @@unique([profileId, skillId])
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  logoUrl     String?
  industry    String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobRoles           JobRole[]
  skillRequirements  CompanySkillRequirement[]
  profiles           StudentProfile[]          @relation("ProfileTargetCompany")
  interviews         Interview[]
  companyReadinesses CompanyReadiness[]
  careerReports      CareerReport[]
}

model JobRole {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  slug          String
  description   String?
  level         String   @default("ENTRY")
  minExperience Int?
  // Score weights per role, e.g. {"RESUME":15,"CODING":25,...} summing to 100.
  weights     Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  skillRequirements  CompanySkillRequirement[]
  skillGaps          SkillGap[]
  learningRoadmaps   LearningRoadmap[]
  companyReadinesses CompanyReadiness[]
  interviews         Interview[]
  careerReports      CareerReport[]
  profiles           StudentProfile[]          @relation("ProfileTargetJobRole")

  @@unique([companyId, slug])
}

model CompanySkillRequirement {
  id             String     @id @default(cuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobRoleId      String
  jobRole        JobRole    @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill      @relation(fields: [skillId], references: [id])
  importance     Importance @default(ESSENTIAL)
  requiredRating Int // 1-5 proficiency required
  weight         Float? // relative weight within the role
  createdAt      DateTime   @default(now())

  @@unique([jobRoleId, skillId])
}

model Resume {
  id         String         @id @default(cuid())
  profileId  String
  profile    StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title      String         @default("My Resume")
  templateId String         @default("modern")
  // Structured resume content, validated with a Zod schema on the server.
  content    Json
  isPrimary  Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  analyses ResumeAnalysis[]
}

model ResumeAnalysis {
  id                String   @id @default(cuid())
  resumeId          String
  resume            Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  overallScore      Int
  atsScore          Int
  contentScore      Int
  keywordScore      Int
  companyMatchScore Int?
  strengths         Json
  weaknesses        Json
  missingSkills     Json
  recommendations   Json
  createdAt         DateTime @default(now())
}

model CodingProblem {
  id                 String     @id @default(cuid())
  title              String     @unique
  slug               String     @unique
  description        String
  constraints        Json
  examples           Json
  difficulty         Difficulty
  topics             Json
  companies          Json
  starterCode        Json // { "python": "...", "javascript": "..." }
  testCases          Json // visible test cases [{ input, expected }]
  hiddenTestCases    Json
  timeLimitMs        Int        @default(4000)
  memoryLimitMB      Int        @default(256)
  expectedComplexity String?
  explanation        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  submissions     CodingSubmission[]
  assessments     CodingAssessment[]
  dailyChallenges DailyChallenge[]
  bookmarks       CodingBookmark[]
}

model CodingSubmission {
  id          String           @id @default(cuid())
  problemId   String
  problem     CodingProblem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  language    String
  code        String
  status      SubmissionStatus @default(PENDING)
  passedTests Int              @default(0)
  totalTests  Int              @default(0)
  runtimeMs   Float?
  memoryKB    Float?
  aiFeedback  Json?
  createdAt   DateTime         @default(now())

  @@index([userId, problemId])
}

model CodingAssessment {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId        String
  problem          CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  attempts         Int           @default(0)
  bestScore        Float         @default(0)
  firstSubmittedAt DateTime      @default(now())
  lastSubmittedAt  DateTime      @default(now())

  @@unique([userId, problemId])
}

model Interview {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?        @relation(fields: [companyId], references: [id])
  jobRoleId     String?
  jobRole       JobRole?        @relation(fields: [jobRoleId], references: [id])
  interviewType InterviewType
  difficulty    Difficulty      @default(MEDIUM)
  status        InterviewStatus @default(IN_PROGRESS)
  score         Float?
  feedback      Json?
  report        Json?
  startedAt     DateTime        @default(now())
  endedAt       DateTime?
  createdAt     DateTime        @default(now())

  questions InterviewQuestion[]
}

model InterviewQuestion {
  id           String    @id @default(cuid())
  interviewId  String
  interview    Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  prompt       String
  questionType String
  order        Int
  createdAt    DateTime  @default(now())

  answer InterviewAnswer?
}

model InterviewAnswer {
  id         String            @id @default(cuid())
  questionId String            @unique
  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText String
  evaluation Json?
  score      Float?
  answeredAt DateTime          @default(now())
}

model CommunicationAnalysis {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript      String
  audioUrl        String?
  metrics         Json // speech rate, filler count, grammar, vocabulary, fluency, clarity
  score           Int
  strengths       Json
  weaknesses      Json
  recommendations Json
  createdAt       DateTime @default(now())
}

model GitHubAnalysis {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username        String
  score           Int
  profileData     Json
  repos           Json
  strengths       Json
  recommendations Json
  createdAt       DateTime @default(now())
}

model LinkedInAnalysis {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileText     String
  score           Int
  strengths       Json
  weaknesses      Json
  recommendations Json
  createdAt       DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  repoUrl     String?
  description String?
  techStack   Json
  createdAt   DateTime @default(now())

  analyses ProjectAnalysis[]
}

model ProjectAnalysis {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  score           Int
  categories      Json // per-category scores
  strengths       Json
  weaknesses      Json
  recommendations Json
  createdAt       DateTime @default(now())
}

model SkillGap {
  id                String         @id @default(cuid())
  profileId         String
  profile           StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobRoleId         String
  jobRole           JobRole        @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  skillId           String
  skill             Skill          @relation(fields: [skillId], references: [id])
  currentRating     Int
  requiredRating    Int
  status            GapStatus
  priority          Int
  reason            String?
  recommendedAction String?
  estimatedEffort   String?
  updatedAt         DateTime       @updatedAt

  @@unique([profileId, jobRoleId, skillId])
}

model LearningRoadmap {
  id            String         @id @default(cuid())
  profileId     String
  profile       StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobRoleId     String
  jobRole       JobRole        @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  durationWeeks Int
  overview      String?
  content       Json
  status        RoadmapStatus  @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tasks RoadmapTask[]
}

model RoadmapTask {
  id          String          @id @default(cuid())
  roadmapId   String
  roadmap     LearningRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  type        TaskType
  week        Int
  title       String
  description String?
  resources   Json
  completed   Boolean         @default(false)
  completedAt DateTime?
}

model CompanyReadiness {
  id           String         @id @default(cuid())
  profileId    String
  profile      StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  jobRoleId    String
  jobRole      JobRole        @relation(fields: [jobRoleId], references: [id])
  overallScore Float
  breakdown    Json
  computedAt   DateTime       @default(now())

  @@unique([profileId, jobRoleId])
}

model ScoreHistory {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ScoreType
  score     Float
  meta      Json?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model CareerReport {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId    String
  companyId    String?
  jobRoleId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  jobRole      JobRole? @relation(fields: [jobRoleId], references: [id])
  overallScore Float
  reportData   Json
  generatedAt  DateTime @default(now())
}

// Immutable audit trail for admin/account actions. Not linked to User via a
// relation so the log survives account deletion (compliance requirement).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  resource   String
  resourceId String?
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorEmail])
  @@index([resource, createdAt])
}

// --- Mentor Chat Persistence ---

model MentorConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages MentorMessage[]

  @@index([userId])
}

model MentorMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String            // "user" | "assistant" | "system"
  content        String
  tokenCount     Int?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

// --- Coding Streak & Daily Challenge ---

model CodingStreak {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  totalSolved    Int       @default(0)
  easySolved     Int       @default(0)
  mediumSolved   Int       @default(0)
  hardSolved     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId])
}

model DailyChallenge {
  id             String    @id @default(cuid())
  challengeDate  DateTime  @unique
  problemId      String
  problem        CodingProblem @relation(fields: [problemId], references: [id])
  createdAt      DateTime  @default(now())
}

model CodingBookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   CodingProblem @relation(fields: [problemId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, problemId])
  @@index([userId])
}

model JDAnalysis {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  company         String?
  description     String
  requiredSkills  Json
  preferredSkills Json
  matchScore      Float?
  missingSkills   Json
  recommendations Json
  createdAt       DateTime @default(now())
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  company     String?
  location    String?
  url         String?
  description String?
  salary      String?
  status       JobStatus @default(SAVED)
  notes        String?
  appliedAt    DateTime?
  followUpDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 PlanType           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([userId])
}
