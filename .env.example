# Copy this file to .env.local and fill real values. NEVER commit .env.local.

# --- Database (Prisma) ---
# SQLite relative paths resolve next to prisma/schema.prisma, so the file is prisma/dev.db
DATABASE_URL="file:./dev.db"

# --- Auth (Auth.js v4) ---
# Generate a real secret with:  npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=
# Dev default; set the deployed URL in production.
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (https://console.cloud.google.com) ---
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM providers (free tiers only, per PRD constraints) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=