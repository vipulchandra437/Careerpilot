# Copy to .env and fill in your values. NEVER commit the real .env file.

# --- Local development (SQLite) ---
# DATABASE_URL="file:./dev.db"

# --- Production (PostgreSQL, via Docker Compose) ---
# DATABASE_URL="postgresql://careerpilot:<password>@db:5432/careerpilot?schema=public"
# POSTGRES_PASSWORD="change-me"

# Generate with: npx auth secret
AUTH_SECRET="generate-a-long-random-secret"
# Required for production hosting behind a proxy (render.com, railway, etc.)
AUTH_TRUST_HOST="true"

# https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
AI_MAX_TOKENS=2000

# Code execution backend: "local" (uses installed Python/Node, ideal for dev)
# or "piston" (self-hosted sandbox; the public emkc.org API now requires a
# token since Feb 2026).
EXECUTION_PROVIDER="local"
# Piston API root. For the self-hosted piston image (piston-api v3) the API is
# mounted under /api/v2, so point this at http://piston:2000/api/v2 in compose.
# The public API is https://emkc.org/api/v2/piston (token required since Feb 2026).
PISTON_API_URL="http://localhost:2000/api/v2"
PISTON_API_KEY=""

# Rate limiting (per-IP, per-minute, applied to mutating /api requests).
# Leave REDIS_URL empty for a single instance; set it to share limits across
# multiple instances (the compose stack provisions one automatically).
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_AUTH=20
RATE_LIMIT_AI=10
RATE_LIMIT_CODING=30
RATE_LIMIT_GENERAL=300
# REDIS_URL="redis://redis:6379"

# Optional: raise GitHub API rate limit
GITHUB_TOKEN=""

# OpenAI-compatible API key (only used if STT is enabled with "openai")
# OPENAI_API_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
