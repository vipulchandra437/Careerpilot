# Runtime environment: use production to enforce required secret checks
ENVIRONMENT=development

# Backend URL used by the Next.js frontend proxy.
BACKEND_API_URL=http://localhost:8000

# Postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_platform

# JWT
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenRouter
OPENROUTER_API_KEY=sk-or-replace-with-your-key
OPENROUTER_SITE_URL=https://your-site.com
OPENROUTER_APP_NAME=CareerPlatform

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# GitHub OAuth token encryption at rest (RULES.md §2). Set to a long random
# string; if left empty we derive from JWT_SECRET_KEY (dev convenience only).
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-a-random-long-key

# S3-compatible storage
S3_BUCKET=career-platform-uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Sandbox
SANDBOX_EXECUTION_TIMEOUT=5
SANDBOX_MEMORY_LIMIT_MB=256

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set ENVIRONMENT=production only with HTTPS storage, authenticated Judge0,
# real OpenRouter credentials, and non-default secrets configured.
