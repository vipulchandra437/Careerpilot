# Copy this file to .env (local dev) and fill real values. NEVER commit .env.
# Prod values are set in the Vercel dashboard ONLY (see ARCHITECTURE.md "Deployment").

# --- Database (Prisma + Postgres on Neon) ---
# Use the POOLED connection string (the -pooler host) from Neon for runtime,
# and the DIRECT connection string for DIRECT_URL. When DIRECT_URL is unset,
# Prisma falls back to DATABASE_URL with a warning (fine for demo-size apps).
# Example shape:
#   DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
#   DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=""
DIRECT_URL=""

# --- Auth (Auth.js v4) ---
# Generate a real secret with:  npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=
# Dev default; set the deployed HTTPS URL in production.
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (https://console.cloud.google.com) ---
# Authorized redirect URIs needed for BOTH origins:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM providers (free tiers only, per PRD constraints) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Optional: production site URL (used only for consistent OG/meta URLs) ---
NEXT_PUBLIC_SITE_URL=