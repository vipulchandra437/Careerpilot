{
  "name": "careerpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"cd frontend && npm run dev\"",
    "build": "npm run build:all",
    "build:frontend": "cd frontend && npm install --no-audit --no-fund && npm run build",
    "build:sync-frontend": "node scripts/sync-frontend.mjs",
    "build:all": "npm run build:frontend && npm run build:sync-frontend && next build",
    "start": "next start",
    "lint": "next lint",
    "graphify": "node scripts/graphify-scan.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@types/three": "^0.185.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "next": "14.2.35",
    "next-auth": "4.24.15",
    "pdf-parse": "^2.4.5",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@reticlehq/next": "^2.13.1",
    "@reticlehq/react": "^2.13.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^8.2.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
